# =================================================================
# SparkStart & SparkBuddy Environment Configuration
# =================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# AI Provider Configuration
# Supported options: 'mock' (default offline mode, no key required), 'gemini', 'openai', 'ollama'
AI_PROVIDER=mock

# Remote Provider Keys (Leave empty to use Mock Mode / local deterministic heuristics)
# Note: SparkStart works 100% offline out-of-the-box using the built-in RAG and heuristic sequencer!
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Privacy and Remote AI Consent Flag
# When false, the application strictly processes tasks locally and will NOT send task text to external remote clouds.
ENABLE_REMOTE_AI=false

# RAG Knowledge Index Path
RAG_KNOWLEDGE_DIR=./knowledge/sources
RAG_TOP_K=3

# Local Database
DATABASE_URL=sqlite:///./sparkstart_local.db

# Frontend Environment Variables (Used by apps/web and apps/desktop)
VITE_API_URL=http://127.0.0.1:8000

